    "index.html": {
      "settings": {
        "main": true,
        "title": "TŌGEYA Malaysia | design by Brian",
        "meta_descr": "The all-new Japanese car culture landmark has arrived in Malaysia. Tōgeya is a brand-new destination that combines Japanese style with car culture, offering a unique experience for car enthusiasts and fans of Japanese culture.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
